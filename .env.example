# Guide Studio Backend Configuration

# Backend API URL (Docker backend gateway)
VITE_API_URL=http://localhost:8000/api/v1

# Backend health check URL (gateway root, not under /api/v1)
VITE_HEALTH_URL=http://localhost:8000/health

# Optional: API Key for additional security
VITE_API_KEY=your-api-key-here

# Server-side AI API keys (passed to Docker backend as fallback)
GROQ_API_KEY=
REPLICATE_API_TOKEN=

# Guide Studio — optional configuration
#
# Guide Studio runs fully locally: recording, editing, captions and export all
# happen on your machine. Nothing here is required to build or run the app.

# Optional: base URL of a self-hosted API, if you run one.
VITE_API_URL=http://localhost:8000/api/v1

# Optional: API key sent with requests to the above URL.
VITE_API_KEY=
